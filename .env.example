# Supabase — from your project's API settings
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role secret — same page, further down ("service_role", marked
# secret). SERVER-ONLY: no NEXT_PUBLIC_ prefix, never exposed to the
# browser. Only used to invite new admins (creating their Supabase Auth
# account + admin_users row bypasses RLS on purpose — see
# supabase/proposed/001_admin_users.sql). Without this set, "Send Invite"
# in Settings fails with a clear "not configured" message instead of a
# silent/broken insert.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — only needed if request headers ever give the wrong origin
# for invite emails' "set your password" link (e.g. behind an unusual
# proxy setup). Normally inferred automatically from the request.
# NEXT_PUBLIC_SITE_URL=https://admin.cassvo.com
